<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Uno.Lint.Cli</RootNamespace>
    <AssemblyName>uno-lint</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>uno-lint</ToolCommandName>
    <PackageId>Uno.Lint.Tool</PackageId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Uno.Lint.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Repl.Core is the dependency-free command runtime (routing, binding, help, output formats, exit codes). The 0.12
         previews map usage and binding errors to exit code 2, which keeps 1 for findings. -->
    <PackageReference Include="Repl.Core" Version="0.12.0-dev.148" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uno.Lint.Host\Uno.Lint.Host.csproj" />
  </ItemGroup>

</Project>
