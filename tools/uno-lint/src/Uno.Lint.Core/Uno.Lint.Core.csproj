<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Uno.Lint</RootNamespace>
    <!-- netstandard2.0 so the same rule library can later be hosted in a Roslyn analyzer. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Lowest Roslyn that a VS 2022 17.8 / .NET 8 SDK analyzer host still loads; keeps the phase 3 analyzer loadable
         in older compilers. The rules use only syntax APIs that exist here. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
