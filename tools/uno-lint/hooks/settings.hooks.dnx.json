{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet dnx -y Uno.Lint.Tool -- --hook",
            "timeout": 10,
            "statusMessage": "uno-lint"
          }
        ]
      }
    ]
  }
}
